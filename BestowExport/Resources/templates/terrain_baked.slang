// Baked terrain look — generated by bestow_export (Godot → bestow).
// A footprint-from-params variant of the isles island_baked shader: the
// same tiled-detail + painted-control blend, but the control-map footprint
// comes from render.params so ONE shader serves every exported terrain:
//
//   params = [ctl_origin_x, ctl_origin_z, ctl_size_x, ctl_size_z]
//
// Bindings: set 0 = control mask (render.texture: R rockness, G autoshader),
// set 2 = grass albedo (render.texture2), set 3 = rock albedo
// (render.texture3); set 1 is the engine frame set (shadow map + lights).

struct Push
{
    float4x4 mvp;
    float4x4 light_mvp;
    float4x4 model;
    float4 n0;
    float4 n1;
    float4 n2;
    float4 color;
    float4 params; // x,y = ctl origin XZ; z,w = ctl size XZ (meters)
};

[[vk::push_constant]]
Push push;

[[vk::binding(0, 0)]]
Sampler2D control_mask;

[[vk::binding(0, 1)]]
Sampler2DShadow shadow_map;

struct PointLight
{
    float4 pos_range;
    float4 color;
};

[[vk::binding(1, 1)]]
cbuffer Lights
{
    float4 light_count;
    float4 sun_dir;
    float4 cam_pos;
    float4 fog_color;
    float4 fog_params;
    PointLight lights[8];
};

[[vk::binding(0, 2)]]
Sampler2D grass_albedo;

[[vk::binding(0, 3)]]
Sampler2D rock_albedo;

// Detail tiling, 1/m. Edit per terrain if your textures want a different
// world frequency.
static const float grass_uv_scale = 0.12;
static const float rock_uv_scale = 0.09;
// Slope autoshader: surface normal Y above/below these reads grass/rock.
static const float grass_slope = 0.82;
static const float rock_slope = 0.62;

struct VIn
{
    [[vk::location(0)]] float3 position;
    [[vk::location(1)]] float3 normal;
    [[vk::location(2)]] float2 uv;
};

struct VOut
{
    float4 position : SV_Position;
    [[vk::location(0)]] float3 normal;
    [[vk::location(1)]] float2 uv;
    [[vk::location(2)]] float4 shadow_coord;
    [[vk::location(3)]] float3 world_pos;
};

[shader("vertex")]
VOut vertMain(VIn vin)
{
    VOut o;
    o.position = mul(push.mvp, float4(vin.position, 1.0));
    o.shadow_coord = mul(push.light_mvp, float4(vin.position, 1.0));
    o.world_pos = mul(push.model, float4(vin.position, 1.0)).xyz;
    o.normal = float3(
        dot(push.n0.xyz, vin.normal),
        dot(push.n1.xyz, vin.normal),
        dot(push.n2.xyz, vin.normal));
    o.uv = vin.uv;
    return o;
}

float shadow_factor(float4 sc)
{
    float3 p = sc.xyz / sc.w;
    float2 uv = p.xy * 0.5 + 0.5;
    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0 || p.z > 1.0)
        return 1.0;
    float texel = 1.0 / 4096.0;
    float sum = 0.0;
    for (int y = -1; y <= 1; y++)
        for (int x = -1; x <= 1; x++)
            sum += shadow_map.SampleCmp(uv + float2(x, y) * texel, p.z);
    return sum / 9.0;
}

float3 point_light_sum(float3 wp, float3 n)
{
    float3 sum = float3(0.0, 0.0, 0.0);
    int count = int(light_count.x);
    for (int i = 0; i < count; i++)
    {
        float3 d = lights[i].pos_range.xyz - wp;
        float dist = length(d);
        float att = saturate(1.0 - dist / lights[i].pos_range.w);
        att *= att;
        sum += lights[i].color.rgb * (max(dot(n, d / max(dist, 1e-4)), 0.0) * att);
    }
    return sum;
}

float3 apply_fog(float3 color, float3 world_pos)
{
    float dist = length(cam_pos.xyz - world_pos);
    float f = (1.0 - exp(-dist * fog_color.w))
            * exp(-max(world_pos.y - fog_params.x, 0.0) * fog_params.y);
    return lerp(color, fog_color.rgb, saturate(f) * fog_params.z);
}

[shader("fragment")]
float4 fragMain(VOut fin)
{
    float3 n = normalize(fin.normal);
    float2 world_xz = fin.world_pos.xz;

    // Painted control vs slope autoshader (mask G selects). Footprint from
    // params — set by the exported entity, no per-terrain shader edits.
    float2 ctl_origin = push.params.xy;
    float2 ctl_size = max(push.params.zw, float2(1e-3, 1e-3));
    float2 cuv = (world_xz - ctl_origin) / ctl_size;
    float2 ctl = control_mask.Sample(saturate(cuv)).rg;
    float slope_rock = smoothstep(grass_slope, rock_slope, n.y);
    float rockness = lerp(ctl.r, slope_rock, ctl.g);

    float3 grass = grass_albedo.Sample(world_xz * grass_uv_scale).rgb;
    float3 rock = rock_albedo.Sample(world_xz * rock_uv_scale).rgb;
    // Break tiling: a second rock tap at a different scale.
    float3 rock_far = rock_albedo.Sample(world_xz * rock_uv_scale * 0.23).rgb;
    rock = lerp(rock, rock_far, 0.4);
    float3 albedo = lerp(grass, rock, saturate(rockness));

    float ndl = max(dot(n, normalize(sun_dir.xyz)), 0.0);
    float lit = ndl * shadow_factor(fin.shadow_coord);
    float3 color = albedo * (0.26 + 0.74 * lit);
    color += albedo * point_light_sum(fin.world_pos, n);
    color = apply_fog(color * push.color.rgb, fin.world_pos);
    return float4(color, push.color.a);
}
